diff --git a/app/composables/useListQuery.ts b/app/composables/useListQuery.ts
new file mode 100644
index 0000000..3c2026b
--- /dev/null
+++ b/app/composables/useListQuery.ts
@@ -0,0 +1,10 @@
+export function useListQuery() {
+  const route = useRoute()
+  const router = useRouter()
+  const query = computed(() => {
+    const { edit: _edit, ...rest } = route.query
+    return Object.fromEntries(Object.entries(rest).filter((entry): entry is [string, string] => typeof entry[1] === 'string'))
+  })
+  const back = computed(() => router.resolve({ path: route.path, query: query.value }).fullPath)
+  return { query, back }
+}
