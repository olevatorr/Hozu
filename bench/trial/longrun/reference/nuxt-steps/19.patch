new file mode 100644
index 0000000..8974f16
--- /dev/null
+++ b/server/api/export.get.ts
@@ -0,0 +1,9 @@
+import type { NotesExport } from '#shared/types/note'
+
+export default defineEventHandler((event): NotesExport => {
+  const user = requireUser(event)
+  return {
+    user,
+    notes: listed(notesOf(user)).map(({ title, pinned, archived, tags, createdAt }) => ({ title, pinned, archived, tags, createdAt })),
+  }
+})
