+const TAG = /^[\p{L}\p{N}-]{1,20}$/u
+
+export function parseTags(raw: string): string[] | null {
+  const tags = [...new Set(raw.split(',').map((tag) => tag.trim().toLowerCase()).filter(Boolean))]
+  return tags.every((tag) => TAG.test(tag)) ? tags : null
+}
