new file mode 100644
index 0000000..5aca26c
--- /dev/null
+++ b/app/components/LanguageSwitch.vue
@@ -0,0 +1,20 @@
+<script setup lang="ts">
+const route = useRoute()
+const { lang, t } = useI18n()
+const submit = useFormAction()
+const next = computed(() => (lang.value === 'en' ? 'de' : 'en'))
+
+async function change(event: SubmitEvent) {
+  const chosen = next.value
+  await submit(event)
+  lang.value = chosen
+}
+</script>
+
+<template>
+  <form method="post" action="/api/lang" @submit.prevent="change">
+    <input type="hidden" name="back" :value="route.fullPath">
+    <input type="hidden" name="lang" :value="next">
+    <button type="submit" class="btn">{{ t('otherLanguage') }}</button>
+  </form>
+</template>
