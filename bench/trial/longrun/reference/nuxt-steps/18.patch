--- /dev/null
+++ b/server/api/lang.post.ts
@@ -0,0 +1,6 @@
+export default defineEventHandler(async (event) => {
+  const form = (await readBody<FormBody>(event)) ?? {}
+  const lang = field(form, 'lang')
+  if (isLang(lang)) setCookie(event, 'lang', lang, { httpOnly: true, sameSite: 'lax', path: '/', maxAge: 60 * 60 * 24 * 365 })
+  return finish(event, backTo(form, '/login'))
+})
