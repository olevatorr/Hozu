diff --git a/app/composables/useI18n.ts b/app/composables/useI18n.ts
new file mode 100644
index 0000000..27e968f
--- /dev/null
+++ b/app/composables/useI18n.ts
@@ -0,0 +1,10 @@
+import type { Lang, MessageKey } from '#shared/utils/messages'
+
+export function useI18n() {
+  const lang = useState<Lang>('lang', () => {
+    const cookie = useCookie('lang').value
+    return isLang(cookie) ? cookie : 'en'
+  })
+  const t = (key: MessageKey, params?: Record<string, string | number>) => translate(lang.value, key, params)
+  return { lang, t }
+}
