+const RATE_LIMIT = 10
+const RATE_WINDOW_MS = 60_000
+const addedAt = new Map<string, number[]>()
+
+function rateLimited(user: string, now: number): boolean {
+  const recent = (addedAt.get(user) ?? []).filter((at) => now - at < RATE_WINDOW_MS)
+  addedAt.set(user, recent)
+  return recent.length >= RATE_LIMIT
+}
