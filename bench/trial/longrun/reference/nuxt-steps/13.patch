+export function deleteNotes(user: string, ids: string[]): void {
+  const notes = notesOf(user)
+  const doomed = new Set(ids.map((id) => activeNote(user, id)).filter((note) => note !== undefined))
+  if (!doomed.size) return
+  notes.splice(0, notes.length, ...notes.filter((note) => !doomed.has(note)))
+  clearUndo(user)
+}
