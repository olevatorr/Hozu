+export default defineUserAction(({ form, user }) => {
+  const ids = fields(form, 'ids')
+  if (field(form, 'op') === 'delete') deleteNotes(user, ids)
+  if (field(form, 'op') === 'archive') for (const id of ids) archiveNote(user, id, true)
+  return backTo(form)
+})
