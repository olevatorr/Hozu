diff --git a/app/pages/admin.vue b/app/pages/admin.vue
new file mode 100644
index 0000000..be1d800
--- /dev/null
+++ b/app/pages/admin.vue
@@ -0,0 +1,28 @@
+<script setup lang="ts">
+import type { AdminPage } from '#shared/types/note'
+
+const { data, error } = await useFetch<AdminPage>('/api/admin')
+if (error.value?.statusCode === 401) await navigateTo('/login')
+if (error.value?.statusCode === 403) throw createError({ statusCode: 403, statusMessage: 'Not allowed', fatal: true })
+</script>
+
+<template>
+  <main v-if="data" class="mx-auto max-w-xl px-4 py-12">
+    <NuxtLink to="/notes" class="text-sm text-indigo-600 hover:underline">Back to notes</NuxtLink>
+    <h1 class="mt-2 text-3xl font-bold tracking-tight">Admin</h1>
+    <table class="mt-6 w-full overflow-hidden rounded-xl bg-white text-left shadow-sm ring-1 ring-slate-200">
+      <thead class="bg-slate-100 text-sm">
+        <tr>
+          <th class="px-4 py-2">User</th>
+          <th class="px-4 py-2">Notes</th>
+        </tr>
+      </thead>
+      <tbody class="divide-y divide-slate-200">
+        <tr v-for="row in data.users" :key="row.user">
+          <td class="px-4 py-2">{{ row.user }}</td>
+          <td class="px-4 py-2">{{ row.notes }}</td>
+        </tr>
+      </tbody>
+    </table>
+  </main>
+</template>
