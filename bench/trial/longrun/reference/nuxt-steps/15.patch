+export function shareNote(user: string, id: string, raw: string): string | null {
+  const name = raw.trim()
+  if (!isValidName(name)) return 'A name is 2–20 letters'
+  if (name === user) return 'You cannot share with yourself'
+  const note = activeNote(user, id)
+  if (note && !note.sharedWith.includes(name)) note.sharedWith.push(name)
+  return null
+}
+
+export function unshareNote(user: string, id: string, name: string): void {
+  const note = activeNote(user, id)
+  if (note) note.sharedWith = note.sharedWith.filter((other) => other !== name)
+}
+
