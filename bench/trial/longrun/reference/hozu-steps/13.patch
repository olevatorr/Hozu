@@ -64,6 +66,18 @@ export function createResolvers() {
     implement(listArchived, (_, { session, fail }) =>
       session ? store.archived(session.user).map(copy) : fail('Unauthorized', {}),
     ),
+    implement(bulkNotes, (fields, { session }) => {
+      if (session) {
+        const ids = Object.keys(fields).filter(
+          (id) => fields[id] === SELECTED && store.find(session.user, id),
+        )
+        if (ids.length) store.forget(session.user)
+        for (const id of ids)
+          if (fields.action === 'archive') store.find(session.user, id)!.archived = true
+          else if (fields.action === 'delete') store.remove(session.user, id, false)
+      }
+      return new Response(null, { status: 303, headers: { location: session ? '/notes' : '/login' } })
+    }),
     implement(lastDeleted, (_, { session }) => {
       const note = session && store.lastDeleted(session.user)
       return note ? { title: note.title } : null
