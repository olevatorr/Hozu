{
  "name": "hozu-site",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "hozu validate",
    "check": "hozu check",
    "export": "node --import @hozu/transform/register export.ts",
    "typecheck": "tsc --noEmit -p .",
    "verify": "node --import @hozu/transform/register verify.ts",
    "verify:browser": "node --import @hozu/transform/register verify-browser.ts"
  },
  "dependencies": {
    "@hozu/adapter-static": "workspace:*",
    "@hozu/bundle": "workspace:*",
    "@hozu/cli": "workspace:*",
    "@hozu/content": "workspace:*",
    "@hozu/core": "workspace:*",
    "@hozu/css": "workspace:*",
    "@hozu/data": "workspace:*",
    "@hozu/runtime-server": "workspace:*",
    "@hozu/schema-zod": "workspace:*",
    "@hozu/testing": "workspace:*",
    "@hozu/transform": "workspace:*",
    "@hozu/variants": "workspace:*",
    "@tailwindcss/typography": "0.5.20",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "zod": "4.6.5"
  },
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@types/three": "0.186.0",
    "highlight.js": "11.11.1"
  }
}
