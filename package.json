{
  "name": "tenon",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/schema-zod packages/machine packages/validator packages/cli",
    "typecheck": "tsc -b tsconfig.json",
    "test": "pnpm build && vitest run",
    "bench": "pnpm build && node bench/run.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "schema": "node scripts/gen-schemas.ts",
    "gate": "pnpm lint && pnpm typecheck && pnpm test && pnpm bench"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tenon/cli": "workspace:*",
    "@tenon/core": "workspace:*",
    "@tenon/machine": "workspace:*",
    "@tenon/schema-zod": "workspace:*",
    "@tenon/validator": "workspace:*",
    "@types/node": "22.20.4",
    "ajv": "8.20.0",
    "fast-check": "4.10.2",
    "ts-json-schema-generator": "2.9.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
