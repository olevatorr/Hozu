{
  "name": "tenon",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -b packages/core packages/schema-zod packages/machine packages/data packages/compiler packages/validator packages/runtime-client packages/runtime-server packages/adapter-node packages/adapter-static packages/cli packages/css packages/dev packages/bundle packages/image packages/content packages/testing && node packages/runtime-client/scripts/bundle.ts",
    "typecheck": "tsc -b tsconfig.json",
    "test": "pnpm build && vitest run",
    "bench": "pnpm build && node bench/run.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "schema": "node scripts/gen-schemas.ts",
    "gate": "pnpm lint && pnpm typecheck && pnpm test && pnpm bench",
    "bench:frameworks": "pnpm build && pnpm --filter bench-frameworks run run",
    "bench:parity": "pnpm build && pnpm --filter bench-parity build:nuxt && pnpm --filter bench-parity run run"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@tenonkit/adapter-node": "workspace:*",
    "@tenonkit/adapter-static": "workspace:*",
    "@tenonkit/bundle": "workspace:*",
    "@tenonkit/cli": "workspace:*",
    "@tenonkit/compiler": "workspace:*",
    "@tenonkit/content": "workspace:*",
    "@tenonkit/core": "workspace:*",
    "@tenonkit/css": "workspace:*",
    "@tenonkit/data": "workspace:*",
    "@tenonkit/dev": "workspace:*",
    "@tenonkit/image": "workspace:*",
    "@tenonkit/machine": "workspace:*",
    "@tenonkit/runtime-client": "workspace:*",
    "@tenonkit/runtime-server": "workspace:*",
    "@tenonkit/schema-zod": "workspace:*",
    "@tenonkit/testing": "workspace:*",
    "@tenonkit/validator": "workspace:*",
    "@types/node": "22.20.4",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "fast-check": "4.10.2",
    "happy-dom": "20.14.5",
    "html-element-attributes": "^3.5.0",
    "playwright-core": "1.63.0",
    "svg-element-attributes": "^2.2.0",
    "ts-json-schema-generator": "2.9.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "zod": "4.6.5"
  }
}
