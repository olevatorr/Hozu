{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/SkillOutput",
  "definitions": {
    "SkillOutput": {
      "type": "object",
      "properties": {
        "written": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "custom": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "guide": {
                "type": "string"
              },
              "block": {
                "type": "string"
              }
            },
            "required": [
              "guide",
              "block"
            ],
            "additionalProperties": false
          },
          "description": "Guides with text outside the markers that equals no known template: paste `block` by hand."
        }
      },
      "required": [
        "written",
        "custom"
      ],
      "additionalProperties": false
    }
  }
}
