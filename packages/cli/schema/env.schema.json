{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/EnvOutput",
  "definitions": {
    "EnvOutput": {
      "type": "object",
      "properties": {
        "files": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "project({ env: { files } })."
        },
        "read": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "The files that existed and were read."
        },
        "variables": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/EnvVariable"
          }
        },
        "reserved": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string"
              },
              "purpose": {
                "type": "string"
              },
              "set": {
                "type": "boolean"
              }
            },
            "required": [
              "name",
              "purpose",
              "set"
            ],
            "additionalProperties": false
          }
        },
        "example": {
          "type": [
            "string",
            "null"
          ],
          "description": "`.env.example` when --example wrote it."
        }
      },
      "required": [
        "files",
        "read",
        "variables",
        "reserved",
        "example"
      ],
      "additionalProperties": false,
      "description": "`hozu env` (ADR 0052)."
    },
    "EnvVariable": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "side": {
          "type": "string",
          "enum": [
            "server",
            "public"
          ]
        },
        "required": {
          "type": "boolean",
          "description": "No default, so startup refuses without it."
        },
        "default": {
          "type": [
            "string",
            "null"
          ]
        },
        "set": {
          "type": "boolean",
          "description": "Set now: in the shell or one of the env files."
        },
        "description": {
          "type": [
            "string",
            "null"
          ]
        },
        "internal": {
          "type": [
            "string",
            "null"
          ],
          "description": "A public variable: the server variable with its internal URL; a server one: the public variable it serves."
        }
      },
      "required": [
        "name",
        "side",
        "required",
        "default",
        "set",
        "description",
        "internal"
      ],
      "additionalProperties": false
    }
  }
}
