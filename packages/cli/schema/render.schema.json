{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/RenderOutput",
  "definitions": {
    "RenderOutput": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "component": {
          "type": "string"
        },
        "variant": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "html": {
          "type": "string"
        },
        "class": {
          "type": "string"
        },
        "owned": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Diagnostic"
          }
        }
      },
      "required": [
        "ok",
        "component",
        "variant",
        "html",
        "class",
        "owned",
        "diagnostics"
      ],
      "additionalProperties": false
    },
    "Diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/definitions/DiagnosticCode"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "message": {
          "type": "string"
        },
        "location": {
          "$ref": "#/definitions/Location"
        },
        "cause": {
          "type": "string"
        },
        "fix": {
          "anyOf": [
            {
              "$ref": "#/definitions/Fix"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "location",
        "cause",
        "fix"
      ],
      "additionalProperties": false
    },
    "DiagnosticCode": {
      "type": "string",
      "enum": [
        "HZ001",
        "HZ002",
        "HZ003",
        "HZ004",
        "HZ005",
        "HZ006",
        "HZ007",
        "HZ008",
        "HZ009",
        "HZ010",
        "HZ011",
        "HZ012",
        "HZ013",
        "HZ014",
        "HZ015",
        "HZ016",
        "HZ017",
        "HZ018",
        "HZ019",
        "HZ020",
        "HZ021",
        "HZ022",
        "HZ023",
        "HZ024",
        "HZ025",
        "HZ026",
        "HZ027",
        "HZ028",
        "HZ029",
        "HZ030",
        "HZ031",
        "HZ032",
        "HZ033",
        "HZ034",
        "HZ035",
        "HZ036",
        "HZ037",
        "HZ038",
        "HZ039",
        "HZ040",
        "HZ041",
        "HZ042",
        "HZ043",
        "HZ044",
        "HZ045",
        "HZ046",
        "HZ047",
        "HZ048",
        "HZ049",
        "HZ050",
        "HZ051",
        "HZ052",
        "HZ053",
        "HZ054",
        "HZ055",
        "HZ056",
        "HZ057",
        "HZ058",
        "HZ059",
        "HZ060",
        "HZ061",
        "HZ062",
        "HZ063",
        "HZ064",
        "HZ070",
        "HZ071",
        "HZ072",
        "HZ073",
        "HZ074",
        "HZ075",
        "HZ076",
        "HZ077",
        "HZ078",
        "HZ079",
        "HZ080",
        "HZ081",
        "HZ082",
        "HZ083",
        "HZ084",
        "HZ085",
        "HZ086",
        "HZ087",
        "HZ088",
        "HZ089",
        "HZ090",
        "HZ091",
        "HZ092",
        "HZ093"
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "error",
        "warning"
      ]
    },
    "Location": {
      "type": "object",
      "properties": {
        "feature": {
          "type": [
            "string",
            "null"
          ]
        },
        "pointer": {
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/definitions/SourceLoc"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "feature",
        "pointer",
        "source"
      ],
      "additionalProperties": false
    },
    "SourceLoc": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "number"
        },
        "column": {
          "type": "number"
        }
      },
      "required": [
        "file",
        "line",
        "column"
      ],
      "additionalProperties": false
    },
    "Fix": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "snippet": {
          "type": [
            "string",
            "null"
          ]
        },
        "patch": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/JsonPatchOp"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "summary",
        "snippet",
        "patch"
      ],
      "additionalProperties": false
    },
    "JsonPatchOp": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "add",
                "replace"
              ]
            },
            "path": {
              "type": "string"
            },
            "value": {
              "$ref": "#/definitions/Json"
            }
          },
          "required": [
            "op",
            "path",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "remove"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Json"
          }
        }
      ]
    }
  }
}
