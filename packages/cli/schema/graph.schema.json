{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/GraphOutput",
  "definitions": {
    "GraphOutput": {
      "type": "object",
      "properties": {
        "feature": {
          "type": "string"
        },
        "nodes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GraphNode"
          }
        },
        "edges": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/GraphEdge"
          }
        }
      },
      "required": [
        "feature",
        "nodes",
        "edges"
      ],
      "additionalProperties": false
    },
    "GraphNode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/GraphNodeKind"
        },
        "label": {
          "type": "string"
        },
        "initial": {
          "type": "boolean"
        },
        "final": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "kind",
        "label",
        "initial",
        "final"
      ],
      "additionalProperties": false
    },
    "GraphNodeKind": {
      "type": "string",
      "enum": [
        "state",
        "effect",
        "event",
        "feature",
        "view",
        "query"
      ]
    },
    "GraphEdge": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/GraphEdgeKind"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to",
        "kind",
        "label"
      ],
      "additionalProperties": false
    },
    "GraphEdgeKind": {
      "type": "string",
      "enum": [
        "on",
        "done",
        "failed",
        "after",
        "invoke",
        "import",
        "send",
        "reads",
        "embeds"
      ]
    }
  }
}
