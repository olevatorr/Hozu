{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/RequestsOutput",
  "definitions": {
    "RequestsOutput": {
      "type": "object",
      "properties": {
        "requests": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "number": {
                "type": "string"
              },
              "file": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "open",
                  "done"
                ]
              },
              "created": {
                "type": "string"
              },
              "result": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "locations": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "number",
              "file",
              "title",
              "status",
              "created",
              "result",
              "locations"
            ],
            "additionalProperties": false
          }
        },
        "done": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "requests",
        "done"
      ],
      "additionalProperties": false
    }
  }
}
