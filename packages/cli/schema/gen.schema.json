{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/GenOutput",
  "definitions": {
    "GenOutput": {
      "type": "object",
      "properties": {
        "contracts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "file": {
                "type": "string",
                "description": "The contract file, relative to the working directory."
              },
              "package": {
                "type": "string"
              },
              "effects": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "ref": {
                      "type": "string"
                    },
                    "fingerprint": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "ref",
                    "fingerprint"
                  ],
                  "additionalProperties": false
                },
                "description": "The effects it implements (feature.symbol), each with the fingerprint its calls carry (ADR 0070 C3)."
              },
              "written": {
                "type": "boolean",
                "description": "False when the file already held this contract."
              },
              "problems": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Effects that cannot be remote (the server refuses to start with them, HZ093)."
              },
              "notes": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "Number fields named like an id or a count, which may want z.int() (ADR 0070 C4), and enums without a title that became several Go types, which a title makes one; not diagnostics."
              }
            },
            "required": [
              "file",
              "package",
              "effects",
              "written",
              "problems",
              "notes"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "contracts"
      ],
      "additionalProperties": false,
      "description": "`hozu gen` (ADR 0068)."
    }
  }
}
