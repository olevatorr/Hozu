{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/RequestOutput",
  "definitions": {
    "RequestOutput": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RequestStep"
          }
        }
      },
      "required": [
        "steps"
      ],
      "additionalProperties": false
    },
    "RequestStep": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "const": "GET"
        },
        "path": {
          "type": "string"
        },
        "status": {
          "type": "number"
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "cookies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RequestElement"
          }
        },
        "forms": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RequestForm"
          }
        }
      },
      "required": [
        "method",
        "path",
        "status",
        "location",
        "cookies",
        "title",
        "alerts",
        "text",
        "truncated",
        "elements",
        "forms"
      ],
      "additionalProperties": false
    },
    "RequestElement": {
      "type": "object",
      "properties": {
        "selector": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "attrs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "selector",
        "tag",
        "attrs",
        "text"
      ],
      "additionalProperties": false
    },
    "RequestForm": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "method": {
          "type": "string",
          "enum": [
            "get",
            "post"
          ]
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "label": {
          "type": [
            "string",
            "null"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RequestFormField"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RequestFormGroup"
          }
        },
        "buttons": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RequestFormButton"
          }
        }
      },
      "required": [
        "action",
        "method",
        "id",
        "label",
        "fields",
        "groups",
        "buttons"
      ],
      "additionalProperties": false
    },
    "RequestFormField": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "outside": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "value",
        "kind",
        "outside"
      ],
      "additionalProperties": false
    },
    "RequestFormGroup": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "type": {
          "type": "string",
          "enum": [
            "checkbox",
            "radio",
            "select"
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string"
              },
              "checked": {
                "type": "boolean"
              }
            },
            "required": [
              "value",
              "checked"
            ],
            "additionalProperties": false
          }
        },
        "outside": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "type",
        "options",
        "outside"
      ],
      "additionalProperties": false
    },
    "RequestFormButton": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "type": [
            "string",
            "null"
          ]
        },
        "outside": {
          "type": "boolean"
        }
      },
      "required": [
        "text",
        "name",
        "value",
        "outside"
      ],
      "additionalProperties": false
    }
  }
}
