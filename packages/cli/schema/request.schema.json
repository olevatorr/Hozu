{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/RequestOutput",
  "definitions": {
    "RequestOutput": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RequestStep"
          }
        }
      },
      "required": [
        "steps"
      ],
      "additionalProperties": false
    },
    "RequestStep": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST"
          ]
        },
        "path": {
          "type": "string"
        },
        "status": {
          "type": "number"
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "required": [
        "method",
        "path",
        "status",
        "location",
        "title",
        "alerts",
        "text",
        "truncated"
      ],
      "additionalProperties": false
    }
  }
}
