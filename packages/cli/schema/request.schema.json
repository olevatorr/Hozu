{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/RequestOutput",
  "definitions": {
    "RequestOutput": {
      "type": "object",
      "properties": {
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RequestStep"
          }
        }
      },
      "required": [
        "steps"
      ],
      "additionalProperties": false
    },
    "RequestStep": {
      "type": "object",
      "properties": {
        "method": {
          "type": "string",
          "enum": [
            "GET",
            "POST"
          ]
        },
        "path": {
          "type": "string"
        },
        "status": {
          "type": "number"
        },
        "location": {
          "type": [
            "string",
            "null"
          ]
        },
        "cookies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "title": {
          "type": [
            "string",
            "null"
          ]
        },
        "alerts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "truncated": {
          "type": "boolean"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RequestElement"
          }
        },
        "forms": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RequestForm"
          }
        }
      },
      "required": [
        "method",
        "path",
        "status",
        "location",
        "cookies",
        "title",
        "alerts",
        "text",
        "truncated",
        "elements",
        "forms"
      ],
      "additionalProperties": false
    },
    "RequestElement": {
      "type": "object",
      "properties": {
        "selector": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "attrs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "selector",
        "tag",
        "attrs",
        "text"
      ],
      "additionalProperties": false
    },
    "RequestForm": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "fields": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "buttons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "action",
        "fields",
        "buttons"
      ],
      "additionalProperties": false
    }
  }
}
