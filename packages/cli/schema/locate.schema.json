        "id",
        "pointer",
        "kind",
        "tag",
        "owner",
        "component",
        "location",
        "classes",
        "text",
        "source",
        "events",
        "conditions",
        "machine",
        "children",
        "excerpt",
        "page"
      ],
      "additionalProperties": false
