    "DevLocation": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "number"
        },
        "column": {
          "type": "number"
        }
      },
      "required": [
        "file",
        "line",
        "column"
      ],
      "additionalProperties": false
    },
    "DevTextSource": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "literal",
            "message",
            "data",
            "context",
            "route",
            "computed"
