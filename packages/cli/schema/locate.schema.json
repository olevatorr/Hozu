{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/LocateOutput",
  "definitions": {
    "LocateOutput": {
      "$ref": "#/definitions/DevNode"
    },
    "DevNode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "pointer": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "element",
            "component",
            "text",
            "query",
            "when",
            "if",
            "list",
            "html",
            "embed",
            "page",
            "other"
          ]
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "feature": {
                  "type": "string"
                },
                "view": {
                  "type": "string"
                }
              },
              "required": [
                "feature",
                "view"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "component": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string"
                },
                "variant": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "declaration": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/DevLocation"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "uses": {
                  "type": "number"
                }
              },
              "required": [
                "ref",
                "variant",
                "declaration",
                "uses"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/definitions/DevLocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "classes": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/definitions/DevTextSource"
            },
            {
              "type": "null"
            }
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dom": {
                "type": "string"
              },
              "event": {
                "type": "string"
              },
              "transitions": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/DevTransition"
                }
              }
            },
            "required": [
              "dom",
              "event",
              "transitions"
            ],
            "additionalProperties": false
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DevCondition"
          }
        },
        "machine": {
          "anyOf": [
