{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/LocateOutput",
  "definitions": {
    "LocateOutput": {
      "$ref": "#/definitions/DevNode"
    },
    "DevNode": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "pointer": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "type": "string",
          "enum": [
            "element",
            "component",
            "text",
            "query",
            "when",
            "if",
            "list",
            "html",
            "embed",
            "other"
          ]
        },
        "tag": {
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "feature": {
                  "type": "string"
                },
                "view": {
                  "type": "string"
                }
              },
              "required": [
                "feature",
                "view"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "component": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string"
                },
                "variant": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "declaration": {
                  "anyOf": [
                    {
                      "$ref": "#/definitions/DevLocation"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "ref",
                "variant",
                "declaration"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/definitions/DevLocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "classes": {
          "type": [
            "string",
            "null"
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "dom": {
                "type": "string"
              },
              "event": {
                "type": "string"
              }
            },
            "required": [
              "dom",
              "event"
            ],
            "additionalProperties": false
          }
        },
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/DevCondition"
          }
        },
        "machine": {
          "anyOf": [
            {
              "$ref": "#/definitions/DevLocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "children": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "kind": {
                "type": "string"
              },
              "text": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "kind",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "excerpt": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "start": {
                  "type": "number"
                },
                "lines": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
                "start",
                "lines"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "pointer",
        "kind",
        "tag",
        "owner",
        "component",
        "location",
        "classes",
        "text",
        "events",
        "conditions",
        "machine",
        "children",
        "excerpt"
      ],
      "additionalProperties": false
    },
    "DevLocation": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "number"
        },
        "column": {
          "type": "number"
        }
      },
      "required": [
        "file",
        "line",
        "column"
      ],
      "additionalProperties": false
    },
    "DevCondition": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "when",
            "if",
            "query",
            "each"
          ]
        },
        "detail": {
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/definitions/DevLocation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "detail",
        "location"
      ],
      "additionalProperties": false
    }
  }
}
