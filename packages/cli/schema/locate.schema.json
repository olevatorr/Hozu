        "uses": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "detail",
        "location",
        "uses"
      ],
      "additionalProperties": false
    },
    "DevTransition": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "guarded": {
          "type": "boolean"
        },
        "navigates": {
          "type": "boolean"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/definitions/DevLocation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "from",
        "to",
        "guarded",
        "navigates",
        "location"
      ],
      "additionalProperties": false
    },
    "DevCondition": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "when",
            "if",
            "query",
            "each"
          ]
        },
        "detail": {
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/definitions/DevLocation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "detail",
        "location"
      ],
      "additionalProperties": false
    },
    "DevPage": {
      "type": "object",
      "properties": {
        "route": {
          "type": "string"
        },
        "path": {
          "type": "string"
