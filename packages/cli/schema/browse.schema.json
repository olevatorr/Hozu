{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/BrowseOutput",
  "definitions": {
    "BrowseOutput": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "status": {
          "type": "number"
        },
        "title": {
          "type": "string"
        },
        "hydrated": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BrowseStep"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BrowseError"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BrowseComponent"
          }
        },
        "text": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RequestElement"
          }
        },
        "screenshot": {
          "type": [
            "string",
            "null"
          ]
        },
        "modes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BrowseMode"
          }
        },
        "actors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BrowseActor"
          }
        }
      },
      "required": [
        "path",
        "url",
        "status",
        "title",
        "hydrated",
        "steps",
        "errors",
        "components",
        "text",
        "truncated",
        "elements",
        "screenshot"
      ],
      "additionalProperties": false
    },
    "BrowseStep": {
      "type": "object",
      "properties": {
        "step": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "actor": {
          "type": "string"
        },
        "modes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BrowseChange"
          }
        },
        "differs": {
          "type": "boolean",
          "description": "Both modes made a request and the resulting text differs."
        },
        "differences": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "on": {
                "type": "string"
              },
              "off": {
                "type": "string"
              }
            },
            "required": [
              "on",
              "off"
            ],
            "additionalProperties": false
          },
          "description": "The words that differ, at most three lines (ADR 0070 B6); a URL pair first when the pages differ."
        },
        "elsewhere": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BrowseElsewhere"
          }
        }
      },
      "required": [
        "step",
        "ok",
        "note"
      ],
      "additionalProperties": false
    },
    "BrowseChange": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/definitions/BrowseMode"
        },
        "ok": {
          "type": "boolean"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "jsOnly": {
          "type": [
            "string",
            "null"
          ]
        },
        "requested": {
          "type": "boolean"
        },
        "navigated": {
          "type": "boolean"
        },
        "document": {
          "type": "string",
          "enum": [
            "in place",
            "reloaded",
            "navigated"
          ],
          "description": "What the step did to the document: kept it, loaded the same URL again, or loaded another one (ADR 0063 C3)."
        },
        "replaced": {
          "type": "number",
          "description": "With the document kept: how many elements are new after the step (a region drawn again)."
        },
        "flashes": {
          "type": "object",
          "properties": {
            "count": {
              "type": "number"
            },
            "elements": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "count",
            "elements"
          ],
          "additionalProperties": false,
          "description": "Elements the step removed and built again unchanged: same tag, class, text, `name`, `id`, `href`, `src`, `type` and parent path (ADR 0067 C2, ADR 0069 A3). `count` counts every such element, `elements` names the outermost ones as CSS-like paths (`main > form > input[name=card]`)."
        },
        "shift": {
          "type": "number",
          "description": "Layout shift no input explains (layout-shift entries without recent input, summed, as CLS counts them)."
        },
        "serverErrors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ServerError"
          },
          "description": "What the app's `onError` received during the step (ADR 0069 A2)."
        },
        "url": {
          "type": "string"
        },
        "status": {
          "type": "number",
          "description": "The status of the page the step loaded, when it is not 200 (a 403 an access check expects)."
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "mode",
        "ok",
        "note",
        "jsOnly",
        "requested",
        "navigated",
        "url",
        "added",
        "removed"
      ],
      "additionalProperties": false
    },
    "BrowseMode": {
      "type": "string",
      "enum": [
        "on",
        "off"
      ]
    },
    "ServerError": {
      "type": "object",
      "properties": {
        "message": {
          "type": "string"
        },
        "effect": {
          "type": "string",
          "description": "The effect (`feature.symbol`) whose resolver or input failed, when known."
        },
        "path": {
          "type": "string",
          "description": "The request path, when known."
        },
        "details": {
          "type": "object",
          "additionalProperties": {},
          "description": "The other fields `onError` received, such as the schema issues of an invalid input and where it came from."
        }
      },
      "required": [
        "message"
      ],
      "additionalProperties": false,
      "description": "One call of the app's `onError` (ADR 0069 A2): a resolver that threw, an invalid input, a failed stream."
    },
    "BrowseElsewhere": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/definitions/BrowseMode"
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "actor",
        "mode",
        "added",
        "removed"
      ],
      "additionalProperties": false
    },
    "BrowseError": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "exception",
            "console",
            "request",
            "server"
          ],
          "description": "`server`: the app's `onError` was called outside any step (opening the page); a step lists its own."
        },
        "text": {
          "type": "string"
        },
        "at": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/definitions/BrowseMode"
        }
      },
      "required": [
        "kind",
        "text",
        "at"
      ],
      "additionalProperties": false
    },
    "BrowseComponent": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "mounted",
            "failed",
            "not mounted"
          ]
        },
        "width": {
          "type": [
            "number",
            "null"
          ]
        },
        "height": {
          "type": [
            "number",
            "null"
          ]
        },
        "canvases": {
          "type": "number"
        },
        "elements": {
          "type": "number"
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "state",
        "width",
        "height",
        "canvases",
        "elements",
        "hint"
      ],
      "additionalProperties": false
    },
    "RequestElement": {
      "type": "object",
      "properties": {
        "selector": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "attrs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "selector",
        "tag",
        "attrs",
        "text"
      ],
      "additionalProperties": false
    },
    "BrowseActor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "status": {
          "type": "number"
        },
        "title": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BrowseStep"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BrowseError"
          }
        },
        "text": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/definitions/BrowseMode"
        }
      },
      "required": [
        "name",
        "url",
        "status",
        "title",
        "steps",
        "errors",
        "text"
      ],
      "additionalProperties": false
    }
  }
}
