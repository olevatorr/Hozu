{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/BrowseOutput",
  "definitions": {
    "BrowseOutput": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "status": {
          "type": "number"
        },
        "title": {
          "type": "string"
        },
        "hydrated": {
          "type": "boolean"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BrowseStep"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BrowseError"
          }
        },
        "components": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BrowseComponent"
          }
        },
        "text": {
          "type": "string"
        },
        "truncated": {
          "type": "boolean"
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/RequestElement"
          }
        },
        "screenshot": {
          "type": [
            "string",
            "null"
          ]
        },
        "modes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BrowseMode"
          }
        },
        "actors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BrowseActor"
          }
        }
      },
      "required": [
        "path",
        "url",
        "status",
        "title",
        "hydrated",
        "steps",
        "errors",
        "components",
        "text",
        "truncated",
        "elements",
        "screenshot"
      ],
      "additionalProperties": false
    },
    "BrowseStep": {
      "type": "object",
      "properties": {
        "step": {
          "type": "string"
        },
        "ok": {
          "type": "boolean"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "actor": {
          "type": "string"
        },
        "modes": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BrowseChange"
          }
        },
        "differs": {
          "type": "boolean"
        },
        "elsewhere": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BrowseElsewhere"
          }
        }
      },
      "required": [
        "step",
        "ok",
        "note"
      ],
      "additionalProperties": false
    },
    "BrowseChange": {
      "type": "object",
      "properties": {
        "mode": {
          "$ref": "#/definitions/BrowseMode"
        },
        "ok": {
          "type": "boolean"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        },
        "jsOnly": {
          "type": [
            "string",
            "null"
          ]
        },
        "requested": {
          "type": "boolean"
        },
        "navigated": {
          "type": "boolean"
        },
        "url": {
          "type": "string"
        },
        "status": {
          "type": "number",
          "description": "The status of the page the step loaded, when it is not 200 (a 403 an access check expects)."
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "mode",
        "ok",
        "note",
        "jsOnly",
        "requested",
        "navigated",
        "url",
        "added",
        "removed"
      ],
      "additionalProperties": false
    },
    "BrowseMode": {
      "type": "string",
      "enum": [
        "on",
        "off"
      ]
    },
    "BrowseElsewhere": {
      "type": "object",
      "properties": {
        "actor": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/definitions/BrowseMode"
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "removed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "actor",
        "mode",
        "added",
        "removed"
      ],
      "additionalProperties": false
    },
    "BrowseError": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "exception",
            "console",
            "request"
          ]
        },
        "text": {
          "type": "string"
        },
        "at": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "actor": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/definitions/BrowseMode"
        }
      },
      "required": [
        "kind",
        "text",
        "at"
      ],
      "additionalProperties": false
    },
    "BrowseComponent": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "state": {
          "type": "string",
          "enum": [
            "mounted",
            "failed",
            "not mounted"
          ]
        },
        "width": {
          "type": [
            "number",
            "null"
          ]
        },
        "height": {
          "type": [
            "number",
            "null"
          ]
        },
        "canvases": {
          "type": "number"
        },
        "elements": {
          "type": "number"
        },
        "hint": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "name",
        "state",
        "width",
        "height",
        "canvases",
        "elements",
        "hint"
      ],
      "additionalProperties": false
    },
    "RequestElement": {
      "type": "object",
      "properties": {
        "selector": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "attrs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "text": {
          "type": "string"
        }
      },
      "required": [
        "selector",
        "tag",
        "attrs",
        "text"
      ],
      "additionalProperties": false
    },
    "BrowseActor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "status": {
          "type": "number"
        },
        "title": {
          "type": "string"
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BrowseStep"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/BrowseError"
          }
        },
        "text": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/definitions/BrowseMode"
        }
      },
      "required": [
        "name",
        "url",
        "status",
        "title",
        "steps",
        "errors",
        "text"
      ],
      "additionalProperties": false
    }
  }
}
