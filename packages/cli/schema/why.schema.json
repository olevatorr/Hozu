            "query": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "title",
            "description",
            "image",
            "type",
            "noindex",
            "query"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "route",
        "path",
        "routeLocation",
        "views",
        "head"
      ],
      "additionalProperties": false
    }
  }
}
