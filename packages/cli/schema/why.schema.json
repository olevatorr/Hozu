        "line": {
          "type": "number"
        },
        "column": {
          "type": "number"
        }
      },
      "required": [
        "file",
        "line",
        "column"
      ],
      "additionalProperties": false
    },
    "DevTextSource": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "literal",
            "message",
            "data",
            "context",
            "route",
            "computed"
          ]
        },
        "detail": {
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/definitions/DevLocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "uses": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "detail",
        "location",
        "uses"
      ],
      "additionalProperties": false
    },
    "DevTransition": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "guarded": {
          "type": "boolean"
        },
        "navigates": {
          "type": "boolean"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/definitions/DevLocation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "from",
        "to",
        "guarded",
        "navigates",
        "location"
      ],
      "additionalProperties": false
    },
    "DevCondition": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "when",
            "if",
            "query",
            "each"
          ]
        },
        "detail": {
          "type": "string"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/definitions/DevLocation"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "detail",
        "location"
      ],
      "additionalProperties": false
    },
    "DevPage": {
      "type": "object",
      "properties": {
        "route": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "routeLocation": {
          "anyOf": [
            {
              "$ref": "#/definitions/DevLocation"
            },
            {
              "type": "null"
            }
          ]
        },
        "views": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "head": {
          "type": "object",
          "properties": {
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "image": {
              "type": [
                "string",
                "null"
              ]
            },
            "type": {
              "type": "string",
              "enum": [
                "website",
                "article"
              ]
            },
            "noindex": {
              "type": "boolean"
