{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ImpactOutput",
  "definitions": {
    "ImpactOutput": {
      "$ref": "#/definitions/Impact"
    },
    "Impact": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ImpactKind"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "queries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ImpactQuery"
          }
        },
        "invalidatedBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uses": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ImpactUse"
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "target",
        "kind",
        "tags",
        "queries",
        "invalidatedBy",
        "uses",
        "features"
      ],
      "additionalProperties": false
    },
    "ImpactKind": {
      "type": "string",
      "enum": [
        "event",
        "query",
        "mutation",
        "tag",
        "fn",
        "view"
      ]
    },
    "ImpactQuery": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "precision": {
          "type": "string",
          "enum": [
            "exact",
            "param-dependent"
          ]
        }
      },
      "required": [
        "ref",
        "tag",
        "precision"
      ],
      "additionalProperties": false
    },
    "ImpactUse": {
      "type": "object",
      "properties": {
        "feature": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "via": {
          "type": "string"
        }
      },
      "required": [
        "feature",
        "at",
        "via"
      ],
      "additionalProperties": false
    }
  }
}
