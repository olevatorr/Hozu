{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ImpactOutput",
  "definitions": {
    "ImpactOutput": {
      "anyOf": [
        {
          "$ref": "#/definitions/Impact"
        },
        {
          "$ref": "#/definitions/ComponentImpact"
        }
      ]
    },
    "Impact": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/definitions/ImpactKind"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "queries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ImpactQuery"
          }
        },
        "invalidatedBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "uses": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ImpactUse"
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "runs": {
          "anyOf": [
            {
              "$ref": "#/definitions/Runs"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where a query or mutation runs (ADR 0049); null for other symbols."
        },
        "access": {
          "type": [
            "string",
            "null"
          ],
          "description": "Who may run it (ADR 0056 B), as the lock records it; null when it declares none."
        }
      },
      "required": [
        "target",
        "kind",
        "tags",
        "queries",
        "invalidatedBy",
        "uses",
        "features",
        "runs",
        "access"
      ],
      "additionalProperties": false
    },
    "ImpactKind": {
      "type": "string",
      "enum": [
        "event",
        "query",
        "mutation",
        "tag",
        "fn",
        "view"
      ]
    },
    "ImpactQuery": {
      "type": "object",
      "properties": {
        "ref": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "precision": {
          "type": "string",
          "enum": [
            "exact",
            "param-dependent"
          ]
        }
      },
      "required": [
        "ref",
        "tag",
        "precision"
      ],
      "additionalProperties": false
    },
    "ImpactUse": {
      "type": "object",
      "properties": {
        "feature": {
          "type": "string"
        },
        "at": {
          "type": "string"
        },
        "via": {
          "type": "string"
        }
      },
      "required": [
        "feature",
        "at",
        "via"
      ],
      "additionalProperties": false
    },
    "Runs": {
      "type": "string",
      "enum": [
        "server",
        "browser",
        "either"
      ],
      "description": "What an effect's implementation needs (ADR 0049): server secrets, browser credentials, or neither."
    },
    "ComponentImpact": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "const": "component"
        },
        "owner": {
          "$ref": "#/definitions/ComponentOwner"
        },
        "uses": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/ComponentUseSite"
          }
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "target",
        "kind",
        "owner",
        "uses",
        "features"
      ],
      "additionalProperties": false
    },
    "ComponentOwner": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "kit",
            "feature"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id"
      ],
      "additionalProperties": false
    },
    "ComponentUseSite": {
      "type": "object",
      "properties": {
        "feature": {
          "type": "string"
        },
        "node": {
          "type": "string"
        },
        "at": {
          "type": [
            "string",
            "null"
          ]
        },
        "variant": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "added": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "feature",
        "node",
        "at",
        "variant",
        "added",
        "overrides"
      ],
      "additionalProperties": false
    }
  }
}
