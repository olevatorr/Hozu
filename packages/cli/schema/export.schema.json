{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/ExportOutput",
  "definitions": {
    "ExportOutput": {
      "type": "object",
      "properties": {
        "out": {
          "type": "string"
        },
        "written": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "skipped": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "route": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "route",
              "reason"
            ],
            "additionalProperties": false
          }
        },
        "needsServer": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": {
                "type": "string"
              },
              "effect": {
                "type": "string"
              },
              "reason": {
                "type": "string"
              }
            },
            "required": [
              "path",
              "effect",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "out",
        "written",
        "skipped",
        "needsServer"
      ],
      "additionalProperties": false,
      "description": "`hozu export` (ADR 0059 H): files written for a static host, and what only a server can answer."
    }
  }
}
