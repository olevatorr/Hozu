{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/CheckOutput",
  "definitions": {
    "CheckOutput": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "types": {
          "type": "object",
          "properties": {
            "ok": {
              "type": "boolean"
            },
            "skipped": {
              "type": "boolean"
            },
            "errors": {
              "type": "array",
              "items": {
                "$ref": "#/definitions/TypeIssue"
              }
            }
          },
          "required": [
            "ok",
            "skipped",
            "errors"
          ],
          "additionalProperties": false
        },
        "validate": {
          "$ref": "#/definitions/ValidateOutput"
        }
      },
      "required": [
        "ok",
        "types",
        "validate"
      ],
      "additionalProperties": false
    },
    "TypeIssue": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "number"
        },
        "column": {
          "type": "number"
        },
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "file",
        "line",
        "column",
        "code",
        "message"
      ],
      "additionalProperties": false
    },
    "ValidateOutput": {
      "type": "object",
      "properties": {
        "ok": {
          "type": "boolean"
        },
        "hash": {
          "type": "string"
        },
        "summary": {
          "type": "object",
          "properties": {
            "errors": {
              "type": "number"
            },
            "warnings": {
              "type": "number"
            }
          },
          "required": [
            "errors",
            "warnings"
          ],
          "additionalProperties": false
        },
        "coverage": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Coverage"
          }
        },
        "lock": {
          "$ref": "#/definitions/LockState"
        },
        "styles": {
          "type": "string",
          "enum": [
            "checked",
            "unavailable"
          ]
        },
        "diagnostics": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Diagnostic"
          }
        }
      },
      "required": [
        "ok",
        "hash",
        "summary",
        "coverage",
        "lock",
        "styles",
        "diagnostics"
      ],
      "additionalProperties": false
    },
    "Coverage": {
      "type": "object",
      "properties": {
        "covered": {
          "type": "number"
        },
        "total": {
          "type": "number"
        },
        "transitions": {
          "type": "number"
        }
      },
      "required": [
        "covered",
        "total",
        "transitions"
      ],
      "additionalProperties": false
    },
    "LockState": {
      "type": "string",
      "enum": [
        "missing",
        "checked",
        "current",
        "stale",
        "updated",
        "skipped"
      ]
    },
    "Diagnostic": {
      "type": "object",
      "properties": {
        "code": {
          "$ref": "#/definitions/DiagnosticCode"
        },
        "severity": {
          "$ref": "#/definitions/Severity"
        },
        "message": {
          "type": "string"
        },
        "location": {
          "$ref": "#/definitions/Location"
        },
        "cause": {
          "type": "string"
        },
        "fix": {
          "anyOf": [
            {
              "$ref": "#/definitions/Fix"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "code",
        "severity",
        "message",
        "location",
        "cause",
        "fix"
      ],
      "additionalProperties": false
    },
    "DiagnosticCode": {
      "type": "string",
      "enum": [
        "HZ001",
        "HZ002",
        "HZ003",
        "HZ004",
        "HZ005",
        "HZ006",
        "HZ007",
        "HZ008",
        "HZ009",
        "HZ010",
        "HZ011",
        "HZ012",
        "HZ013",
        "HZ014",
        "HZ015",
        "HZ016",
        "HZ017",
        "HZ018",
        "HZ019",
        "HZ020",
        "HZ021",
        "HZ022",
        "HZ023",
        "HZ024",
        "HZ025",
        "HZ026",
        "HZ027",
        "HZ028",
        "HZ029",
        "HZ030",
        "HZ031",
        "HZ032",
        "HZ033",
        "HZ034",
        "HZ035",
        "HZ036",
        "HZ037",
        "HZ038",
        "HZ039",
        "HZ040",
        "HZ041",
        "HZ042",
        "HZ043",
        "HZ044",
        "HZ045",
        "HZ046",
        "HZ047",
        "HZ048",
        "HZ049",
        "HZ050",
        "HZ059",
        "HZ062"
      ]
    },
    "Severity": {
      "type": "string",
      "enum": [
        "error",
        "warning"
      ]
    },
    "Location": {
      "type": "object",
      "properties": {
        "feature": {
          "type": [
            "string",
            "null"
          ]
        },
        "pointer": {
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/definitions/SourceLoc"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "feature",
        "pointer",
        "source"
      ],
      "additionalProperties": false
    },
    "SourceLoc": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": "number"
        },
        "column": {
          "type": "number"
        }
      },
      "required": [
        "file",
        "line",
        "column"
      ],
      "additionalProperties": false
    },
    "Fix": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string"
        },
        "snippet": {
          "type": [
            "string",
            "null"
          ]
        },
        "patch": {
          "anyOf": [
            {
              "type": "array",
              "items": {
                "$ref": "#/definitions/JsonPatchOp"
              }
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "summary",
        "snippet",
        "patch"
      ],
      "additionalProperties": false
    },
    "JsonPatchOp": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "enum": [
                "add",
                "replace"
              ]
            },
            "path": {
              "type": "string"
            },
            "value": {
              "$ref": "#/definitions/Json"
            }
          },
          "required": [
            "op",
            "path",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "type": "string",
              "const": "remove"
            },
            "path": {
              "type": "string"
            }
          },
          "required": [
            "op",
            "path"
          ],
          "additionalProperties": false
        }
      ]
    },
    "Json": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/definitions/Json"
          }
        },
        {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/Json"
          }
        }
      ]
    }
  }
}
