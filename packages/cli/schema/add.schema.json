{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$ref": "#/definitions/AddOutput",
  "definitions": {
    "AddOutput": {
      "type": "object",
      "properties": {
        "created": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "edited": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "manual": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "declarations": {
          "type": "object",
