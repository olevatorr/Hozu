{
  "name": "@hozu/cli",
  "version": "0.5.0",
  "description": "The hozu command: validate, inspect, graph, explain, impact, plan, build and skill (all with --json)",
  "keywords": [
    "hozu",
    "framework",
    "ai",
    "agents",
    "ssr",
    "islands",
    "typescript"
  ],
  "homepage": "https://github.com/olevatorr/Hozu/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/olevatorr/Hozu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olevatorr/Hozu.git",
    "directory": "packages/cli"
  },
  "license": "MIT",
  "author": "olevatorr",
  "type": "module",
  "bin": {
    "hozu": "./bin/hozu.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema/*": "./schema/*"
  },
  "files": [
    "bin",
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hozu/core": "workspace:*",
    "@hozu/validator": "workspace:*",
    "@hozu/machine": "workspace:*",
    "@hozu/compiler": "workspace:*",
    "create-hozu": "workspace:*",
    "@hozu/transform": "workspace:*"
  }
}
