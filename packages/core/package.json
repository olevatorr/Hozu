{
  "name": "@hozu/core",
  "version": "0.18.2",
  "description": "Hozu IR types and the typed builders you author apps with: feature, machine, query, mutation, ui, contract, project",
  "keywords": [
    "hozu",
    "framework",
    "ai",
    "agents",
    "ssr",
    "islands",
    "typescript"
  ],
  "homepage": "https://github.com/olevatorr/Hozu/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/olevatorr/Hozu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olevatorr/Hozu.git",
    "directory": "packages/core"
  },
  "license": "MIT",
  "funding": "https://ko-fi.com/hozu",
  "author": "olevatorr",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ir": {
      "types": "./dist/ir.d.ts",
      "default": "./dist/ir.js"
    },
    "./schema/*": "./schema/*",
    "./canonical": {
      "types": "./dist/canonical/stringify.d.ts",
      "default": "./dist/canonical/stringify.js"
    },
    "./forms": {
      "types": "./dist/ir/forms.d.ts",
      "default": "./dist/ir/forms.js"
    },
    "./component": {
      "types": "./dist/component.d.ts",
      "default": "./dist/component.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "default": "./dist/fetch.js"
    },
    "./preview": {
      "types": "./dist/preview.d.ts",
      "default": "./dist/preview.js"
    },
    "./lower": {
      "types": "./dist/lower.d.ts",
      "default": "./dist/lower.js"
    }
  },
  "files": [
    "dist",
    "schema"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false
}
