{
  "name": "@hozu/adapter-static",
  "version": "0.16.0",
  "description": "Export a Hozu app as static files",
  "keywords": [
    "hozu",
    "framework",
    "ai",
    "agents",
    "ssr",
    "islands",
    "typescript"
  ],
  "homepage": "https://github.com/olevatorr/Hozu/tree/main/packages/adapter-static#readme",
  "bugs": {
    "url": "https://github.com/olevatorr/Hozu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olevatorr/Hozu.git",
    "directory": "packages/adapter-static"
  },
  "license": "MIT",
  "funding": "https://ko-fi.com/hozu",
  "author": "olevatorr",
  "type": "module",
