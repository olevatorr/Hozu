{
  "name": "@hozu/dev",
  "version": "0.20.0",
  "description": "Hozu development server: CSS hot swap, state-keeping reloads and Hozu DevTools",
  "keywords": [
    "hozu",
    "framework",
    "ai",
    "agents",
    "ssr",
    "islands",
    "typescript"
  ],
  "homepage": "https://github.com/olevatorr/Hozu/tree/main/packages/dev#readme",
  "bugs": {
    "url": "https://github.com/olevatorr/Hozu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olevatorr/Hozu.git",
    "directory": "packages/dev"
  },
  "license": "MIT",
  "funding": "https://ko-fi.com/hozu",
  "author": "olevatorr",
  "type": "module",
  "bin": {
    "hozu-dev": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hozu/devtools": "workspace:*",
    "@hozu/runtime-client": "workspace:*"
  },
  "sideEffects": false
}
