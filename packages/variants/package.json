{
  "name": "@hozu/variants",
  "version": "0.20.0",
  "description": "tailwind-variants for Hozu components, run at record time; /config generates the tailwind-merge config",
  "keywords": [
    "hozu",
    "framework",
    "ai",
    "agents",
    "ssr",
    "islands",
    "typescript"
  ],
  "homepage": "https://github.com/olevatorr/Hozu/tree/main/packages/variants#readme",
  "bugs": {
    "url": "https://github.com/olevatorr/Hozu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olevatorr/Hozu.git",
    "directory": "packages/variants"
  },
  "license": "MIT",
  "funding": "https://ko-fi.com/hozu",
  "author": "olevatorr",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "tailwind-merge": "3.7.0",
    "tailwind-variants": "3.3.1"
  },
  "sideEffects": false
}
