{
  "name": "@hozu/runtime-client",
  "version": "0.26.3",
  "description": "Hozu client runtime: fine-grained DOM islands, no virtual DOM, about 9 KB gzipped",
  "keywords": [
    "hozu",
    "framework",
    "ai",
    "agents",
    "ssr",
    "islands",
    "typescript"
  ],
  "homepage": "https://github.com/olevatorr/Hozu/tree/main/packages/runtime-client#readme",
  "bugs": {
    "url": "https://github.com/olevatorr/Hozu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/olevatorr/Hozu.git",
    "directory": "packages/runtime-client"
  },
  "license": "MIT",
  "funding": "https://ko-fi.com/hozu",
  "author": "olevatorr",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./browser/*": "./dist/browser/*",
    "./files": {
      "types": "./files.d.ts",
      "default": "./dist/files.js"
    },
    "./browser-dev/*": "./dist/browser-dev/*"
  },
  "files": [
    "dist",
    "files.d.ts"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hozu/core": "workspace:*",
    "@hozu/machine": "workspace:*"
  },
  "sideEffects": false
}
